{
  "name": "freedocstore-platform",
  "private": true,
  "description": "FreeDocStore platform monorepo",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "check:identity": "node scripts/check-product-identity.mjs",
    "test:identity": "node --test scripts/check-product-identity.test.mjs",
    "reader:build": "node templates/read-aloud/build.mjs",
    "test:browser": "npm --prefix extension run test:browser",
    "editor:typecheck": "pnpm --dir apps/editor typecheck",
    "editor:build": "pnpm --dir apps/editor build",
    "api:typecheck": "npm --prefix workers/api run typecheck",
    "api:test": "npm --prefix workers/api run test",
    "api:deploy": "npm --prefix workers/api run deploy",
    "mcp:typecheck": "npm --prefix workers/mcp run typecheck",
    "mcp:test": "npm --prefix workers/mcp run test",
    "mcp:deploy": "npm --prefix workers/mcp run deploy",
    "test": "npm run editor:typecheck && npm run api:typecheck && npm run api:test && npm run mcp:typecheck && npm run mcp:test"
  }
}
